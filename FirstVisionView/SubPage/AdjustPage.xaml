<UserControl x:Class="VisionView.AdjustPage"
             xmlns="http://schemas.microsoft.com/winfx/2006/xaml/presentation"
             xmlns:x="http://schemas.microsoft.com/winfx/2006/xaml"
             xmlns:mc="http://schemas.openxmlformats.org/markup-compatibility/2006" 
             xmlns:d="http://schemas.microsoft.com/expression/blend/2008" 
             xmlns:local="clr-namespace:VisionView"
             xmlns:toolcard ="clr-namespace:VisionView.Card"
             xmlns:vm ="clr-namespace:VisionView.ViewModels"
             xmlns:core="clr-namespace:VisionView.Core"
             xmlns:dataModel="clr-namespace:VisionView.DataModel"
             mc:Ignorable="d" 
             d:DesignHeight="800" d:DesignWidth="1600"
             d:DataContext="{d:DesignData Type=vm:AdjustViewModel}"
             DataContext="{Binding AdjustVM}"
             Background="#F5F5F5">
    <UserControl.Resources>
        <core:BindingProxy x:Key="VMProxy" Data="{Binding}"/>
        <DataTemplate DataType="{x:Type dataModel:MenuOperator}">
            <TextBlock Text="{Binding DispalyName}" Margin="10,5"/>
        </DataTemplate>
        <HierarchicalDataTemplate DataType="{x:Type dataModel:MenuCategory}" ItemsSource="{Binding SubOperator}">
            <TextBlock Text="{Binding CategoryName}"/>
            <HierarchicalDataTemplate.ItemContainerStyle>
                <Style TargetType="MenuItem">
                    <Setter Property="Command" Value="{Binding Data.AddCardCommand,Source={StaticResource VMProxy}}"/>
                    <Setter Property="CommandParameter" Value="{Binding}"/>
                </Style>
            </HierarchicalDataTemplate.ItemContainerStyle>
        </HierarchicalDataTemplate>
    </UserControl.Resources>
    <!-- 给一个底色区分 -->
    <Grid>
        <Grid.ColumnDefinitions>
            <!-- 左侧：参数卡片区域 -->
            <ColumnDefinition Width="1*"/>
            <!-- 右侧：图像显示区域 -->
            <ColumnDefinition Width="1.5*"/>
        </Grid.ColumnDefinitions>
        <Grid Grid.Column="0">
            <Border HorizontalAlignment="Stretch" VerticalAlignment="Stretch" 
                    ClipToBounds="True"
                    Background="#F5F5F5"
                    MouseLeftButtonDown="CanvasLeftDown" 
                    MouseLeftButtonUp="CanvasLeftUp" 
                    MouseMove="CanvasMouseMove"  
                    MouseRightButtonUp="RightUp"
                    PreviewMouseWheel="Canvas_PreviewMouseWheel"
                    PreviewMouseRightButtonDown="CanvasRightDown"
                    PreviewMouseMove="Canvas_PreviewMouseMove"
                    PreviewMouseRightButtonUp="Canvas_PreviewMouseRightButtonUp">
                <Border.ContextMenu>
                    <ContextMenu ItemsSource="{Binding OperatorMenuTree}"/>
                </Border.ContextMenu>
                <Grid>
                    <Border x:Name="GridBackgroundLayer" Visibility="Collapsed" IsHitTestVisible="False">
                        <Border.Background>
                            <DrawingBrush TileMode="Tile" Viewport="0,0,10,10" ViewportUnits="Absolute">
                                <DrawingBrush.Transform>
                                    <TransformGroup>
                                        <ScaleTransform ScaleX="{Binding ElementName=CanvasScale, Path=ScaleX}"
                                ScaleY="{Binding ElementName=CanvasScale, Path=ScaleY}"/>
                                        <TranslateTransform X="{Binding ElementName=CanvasTranslate, Path=X}"
                                Y="{Binding ElementName=CanvasTranslate, Path=Y}"/>
                                    </TransformGroup>
                                </DrawingBrush.Transform>
                                <DrawingBrush.Drawing>
                                    <GeometryDrawing Geometry="M 20 0 L 0 0 0 20">
                                        <GeometryDrawing.Pen>
                                            <Pen Brush="#D0D0D0" Thickness="1" DashStyle="{x:Static DashStyles.Dot}"/>
                                        </GeometryDrawing.Pen>
                                    </GeometryDrawing>
                                </DrawingBrush.Drawing>
                            </DrawingBrush>
                        </Border.Background>
                    </Border>
                    <Canvas x:Name="ParamentCanvas" 
                        IsHitTestVisible="True"
                        Focusable="True"
                        Background="Transparent">
                        <Canvas.RenderTransform>
                            <TransformGroup>
                                <ScaleTransform x:Name="CanvasScale" ScaleX="1" ScaleY="1"/>
                                <TranslateTransform x:Name="CanvasTranslate" X="0" Y="0"/>
                            </TransformGroup>
                        </Canvas.RenderTransform>

                        <ItemsControl ItemsSource="{Binding AllCards}">
                            <ItemsControl.ItemsPanel>
                                <ItemsPanelTemplate>
                                    <Canvas Background="Transparent"/>
                                </ItemsPanelTemplate>
                            </ItemsControl.ItemsPanel>
                            <ItemsControl.ItemTemplate>
                                <DataTemplate>
                                    <toolcard:ToolCard MouseLeftButtonDown="CardLeftDown"
                                           MouseLeftButtonUp="CardLeftUp"
                                           MouseMove="CardMouseMove"
                                           MouseDoubleClick="CardDoubleClick"
                                           MouseRightButtonUp="RightUp"/>
                                </DataTemplate>
                            </ItemsControl.ItemTemplate>
                            <ItemsControl.ItemContainerStyle>
                                <Style TargetType="ContentPresenter">
                                    <Setter Property="Canvas.Left" Value="{Binding X}"/>
                                    <Setter Property="Canvas.Top" Value="{Binding Y}"/>
                                    <Setter Property="Panel.ZIndex" Value="{Binding TopZIndex}"/>
                                </Style>
                            </ItemsControl.ItemContainerStyle>
                        </ItemsControl>
                        <Rectangle x:Name="SelectionBox" Panel.ZIndex="9999" Stroke="DodgerBlue" StrokeThickness="1" StrokeDashArray="4 2" Fill="#330078D7" IsHitTestVisible="False" Visibility="Collapsed"/>
                        <Path x:Name="GhostLine"
                              Stroke="DodgerBlue"
                              StrokeThickness="3"
                              StrokeDashArray="4 2"
                              IsHitTestVisible="False"
                              Visibility="Collapsed"
                              Panel.ZIndex="10000">
                        </Path>
                    </Canvas>
                </Grid>
            </Border>
            <!--缩放百分比-->
            <TextBlock x:Name="LeftZoomLevelText" Text="100%" HorizontalAlignment="Left" VerticalAlignment="Bottom" Margin="10,20,10,25" Foreground="Gray" IsHitTestVisible="False"/>
            <Popup x:Name="DeleteCard" AllowsTransparency="True"  IsOpen="{Binding DelePopup, Mode=TwoWay}" Panel.ZIndex="10" StaysOpen="False" Placement="Mouse">
                <Border Padding="15">
                    <Border Width="100" MinHeight="27" CornerRadius="10" Background="White" Style="{StaticResource BorderStyle}">
                        <StackPanel>
                            <Button Content="删除Card" Width="70" Command="{Binding DeleteCardsCommand}" Foreground="Red" Style="{StaticResource MenuButtonStyle}"/>
                            <Button Content="重命名Card" Width="70" IsEnabled="{Binding CanRename}" Command="{Binding CardRenameCommand}" Foreground="Black"  Style="{StaticResource MenuButtonStyle}"/>
                        </StackPanel>
                    </Border>
                </Border>
            </Popup>
            <Border d:Visibility="Visible" x:Name="CapBorder" Background="#99FFFFFF" Panel.ZIndex="98">
                <Border.Style>
                    <Style TargetType="Border">
                        <Setter Property="Visibility" Value="Collapsed"/>
                        <Setter Property="Opacity" Value="0"/>
                        <Style.Triggers>
                            <DataTrigger Binding="{Binding Cap}" Value="True">
                                <DataTrigger.EnterActions>
                                    <BeginStoryboard>
                                        <Storyboard>
                                            <ObjectAnimationUsingKeyFrames Storyboard.TargetProperty="Visibility" >
                                                <DiscreteObjectKeyFrame KeyTime="0" Value="{x:Static Visibility.Visible}"/>
                                            </ObjectAnimationUsingKeyFrames>
                                        </Storyboard>
                                    </BeginStoryboard>
                                </DataTrigger.EnterActions>
                                <DataTrigger.ExitActions>
                                    <BeginStoryboard>
                                        <Storyboard>
                                            <DoubleAnimation Storyboard.TargetProperty="Opacity" To="0" Duration="0:0:0.15"/>
                                            <ObjectAnimationUsingKeyFrames Storyboard.TargetProperty="Visibility" BeginTime="0:0:0.15">
                                                <DiscreteObjectKeyFrame KeyTime="0" Value="{x:Static Visibility.Collapsed}"/>
                                            </ObjectAnimationUsingKeyFrames>
                                        </Storyboard>
                                    </BeginStoryboard>
                                </DataTrigger.ExitActions>
                            </DataTrigger>
                        </Style.Triggers>
                    </Style>
                </Border.Style>
            </Border>
            <Border d:Visibility="Visible" d:Opacity="100" x:Name="ParameterCard" Panel.ZIndex="100" Background="#ffffff" MaxHeight="600" MaxWidth="600" CornerRadius="70" >

                <Border.RenderTransform>
                    <ScaleTransform ScaleX="1" ScaleY="1" CenterX="200" CenterY="300"/>
                </Border.RenderTransform>
                <Border.Style>
                    <Style TargetType="Border">
                        <Setter Property="Visibility" Value="Collapsed"/>
                        <Setter Property="Opacity" Value="0"/>
                        <Setter Property="Effect">
                            <Setter.Value>
                                <DropShadowEffect BlurRadius="10" Color="#20000000" Opacity="0.5" ShadowDepth="1" />
                            </Setter.Value>
                        </Setter>
                        <Style.Triggers>
                            <DataTrigger Binding="{Binding Cap}" Value="True">
                                <DataTrigger.EnterActions>
                                    <BeginStoryboard>
                                        <Storyboard>
                                            <ObjectAnimationUsingKeyFrames Storyboard.TargetProperty="Visibility" >
                                                <DiscreteObjectKeyFrame KeyTime="0" Value="{x:Static Visibility.Visible}"/>
                                            </ObjectAnimationUsingKeyFrames>
                                            <DoubleAnimation Storyboard.TargetProperty="Opacity" To="1" Duration="0:0:0.15"/>
                                            <DoubleAnimation Storyboard.TargetProperty="(UIElement.RenderTransform).(ScaleTransform.ScaleX)" To="1" Duration="0:0:0.25">
                                                <DoubleAnimation.EasingFunction>
                                                    <BackEase Amplitude="0.5" EasingMode="EaseOut"/>
                                                </DoubleAnimation.EasingFunction>
                                            </DoubleAnimation>
                                            <DoubleAnimation Storyboard.TargetProperty="(UIElement.RenderTransform).(ScaleTransform.ScaleY)" To="1" Duration="0:0:0.25">
                                                <DoubleAnimation.EasingFunction>
                                                    <BackEase Amplitude="0.5" EasingMode="EaseOut"/>
                                                </DoubleAnimation.EasingFunction>
                                            </DoubleAnimation>
                                        </Storyboard>
                                    </BeginStoryboard>
                                </DataTrigger.EnterActions>
                                <DataTrigger.ExitActions>
                                    <BeginStoryboard>
                                        <Storyboard>
                                            <DoubleAnimation Storyboard.TargetProperty="Opacity" To="0" Duration="0:0:0.15"/>
                                            <DoubleAnimation Storyboard.TargetProperty="(UIElement.RenderTransform).(ScaleTransform.ScaleX)" To="0.8" Duration="0:0:0.15"/>
                                            <DoubleAnimation Storyboard.TargetProperty="(UIElement.RenderTransform).(ScaleTransform.ScaleY)" To="0.8" Duration="0:0:0.15"/>
                                            <ObjectAnimationUsingKeyFrames Storyboard.TargetProperty="Visibility" BeginTime="0:0:0.15">
                                                <DiscreteObjectKeyFrame KeyTime="0" Value="{x:Static Visibility.Collapsed}"/>
                                            </ObjectAnimationUsingKeyFrames>
                                        </Storyboard>
                                    </BeginStoryboard>
                                </DataTrigger.ExitActions>
                            </DataTrigger>
                        </Style.Triggers>
                    </Style>
                </Border.Style>
                <Grid>
                    <Grid.RowDefinitions>
                        <RowDefinition Height="70"/>
                        <RowDefinition Height="10*"/>
                        <RowDefinition Height="1*"/>
                    </Grid.RowDefinitions>
                    <Grid.ColumnDefinitions>
                        <ColumnDefinition Width="1*"/>
                        <ColumnDefinition Width="1*"/>
                    </Grid.ColumnDefinitions>
                    <TextBlock DataContext="{Binding CurrentEditVM}" FontSize="30" Text="{Binding Title}" HorizontalAlignment="Center" VerticalAlignment="Center" Grid.ColumnSpan ="2"/>
                    <ScrollViewer d:Visibility="Visible" VerticalScrollBarVisibility="Auto" Grid.ColumnSpan="2" Grid.Row="1">
                        <StackPanel>
                            <ItemsControl Grid.IsSharedSizeScope="True" Padding="80,5,40,10" DataContext="{Binding CurrentEditVM}" ItemsSource="{Binding ParameterList}"/>
                        </StackPanel>
                    </ScrollViewer>
                    <Button Grid.Row="2" d:Visibility="Visible" Grid.Column="1"  x:Name="Accept" Margin="0,0,0,10" local:ButtonHelp.CornerRadius="13" Content="确认" Command="{Binding ParameterClickCommand}" Height="35" Width="100" Style="{StaticResource ButtonStyle}" />
                    <Button Grid.Row="2" d:Visibility="Visible" Grid.Column="0" x:Name="Cancel"  Margin="0,0,0,10" local:ButtonHelp.CornerRadius="13" Content="取消" Command="{Binding ParameterClickCommand}" Height="35" Width="100" Style="{StaticResource ButtonStyle}" />
                </Grid>
            </Border>
        </Grid>
        <!-- ======================= 右侧：图像显示与工具区域 ======================= -->
        <Grid Grid.Column="1">
            <Grid.RowDefinitions>
                <RowDefinition Height="Auto"/>
                <!-- 顶部工具栏高度自适应 -->
                <RowDefinition Height="*"/>
                <!-- 图像区域占据剩余全部 -->
            </Grid.RowDefinitions>
            <!-- 1. 顶部工具栏 -->
            <Border Grid.Row="0" Background="#EAEAEA" BorderThickness="0" HorizontalAlignment="Stretch" Padding="10,5">
                <Border.Effect>
                    <DropShadowEffect ShadowDepth="1" BlurRadius="10" Color="#20000000" Opacity="0.3"/>
                </Border.Effect>
                <StackPanel Orientation="Horizontal" VerticalAlignment="Center">
                    <ComboBox x:Name="LayerSelection" Width="150" MaxHeight="35" Background="#FFFFFF" Style="{StaticResource ComboboxStyle}"/>
                    <ComboBox x:Name="CameraSelection" Margin="30,0,0,0" Width="100" Background="#FFFFFF" MaxHeight="35" Style="{StaticResource ComboboxStyle}"/>

                    <Button x:Name="Enlarge" Margin="20,0,0,0" Content="➕" FontSize="20" Background="#FFFFFF" Foreground="Gray" Style="{StaticResource ButtonStyle}" />
                    <Button x:Name="Reduce" Margin="10,0,0,0" Content="➖" FontSize="20" Background="#FFFFFF" Foreground="Gray" Style="{StaticResource ButtonStyle}" />
                    <Button x:Name="Adaption" Click="FullButtonClick" Margin="10,0,0,0" Content="Full" FontSize="20" Background="#FFFFFF" Foreground="Gray" Style="{StaticResource ButtonStyle}" />

                    <!-- RGB/HSV 显示区 -->
                    <Grid Margin="30,0,0,0">
                        <Grid.ColumnDefinitions>
                            <ColumnDefinition Width="Auto"/>
                            <ColumnDefinition Width="50"/>
                            <ColumnDefinition Width="Auto"/>
                            <ColumnDefinition Width="50"/>
                            <ColumnDefinition Width="Auto"/>
                            <ColumnDefinition Width="50"/>
                            <ColumnDefinition Width="Auto"/>
                            <ColumnDefinition Width="50"/>
                            <ColumnDefinition Width="Auto"/>
                            <ColumnDefinition Width="50"/>
                            <ColumnDefinition Width="Auto"/>
                            <ColumnDefinition Width="50"/>
                        </Grid.ColumnDefinitions>
                        <Label Content="R:" Grid.Column="0" FontSize="16" VerticalAlignment="Center"/>
                        <Label x:Name="RValue" Content="0" Grid.Column="1" FontSize="16" VerticalAlignment="Center"/>
                        <Label Content="G:" Grid.Column="2" FontSize="16" VerticalAlignment="Center"/>
                        <Label x:Name="GValue" Content="0" Grid.Column="3" FontSize="16" VerticalAlignment="Center"/>
                        <Label Content="B:" Grid.Column="4" FontSize="16" VerticalAlignment="Center"/>
                        <Label x:Name="BValue" Content="0" Grid.Column="5" FontSize="16" VerticalAlignment="Center"/>
                        <Label Content="H:" Grid.Column="6" FontSize="16" VerticalAlignment="Center"/>
                        <Label x:Name="HValue" Content="0" Grid.Column="7" FontSize="16" VerticalAlignment="Center"/>
                        <Label Content="S:" Grid.Column="8" FontSize="16" VerticalAlignment="Center"/>
                        <Label x:Name="SValue" Content="0" Grid.Column="9" FontSize="16" VerticalAlignment="Center"/>
                        <Label Content="V:" Grid.Column="10" FontSize="16" VerticalAlignment="Center"/>
                        <Label x:Name="VValue" Content="0" Grid.Column="11" FontSize="16" VerticalAlignment="Center"/>
                    </Grid>
                </StackPanel>
            </Border>

            <!-- 2. 图像显示与 ROI 区域 -->
            <!-- 外层加一个 Grid 并设置 ClipToBounds，防止图像放大后跑出版面 -->
            <Grid Grid.Row="1" ClipToBounds="True" Background="Transparent">
                <Grid.RowDefinitions>
                    <RowDefinition Height="*"/>
                    <RowDefinition Height="auto"/>
                </Grid.RowDefinitions>
                <!-- 机器视觉习惯用深灰色底看图 -->
                <!-- RenderOptions.BitmapScalingMode="NearestNeighbor" -->
                <!-- 作用：当图片被无限放大时，显示为一个一个的方块像素，绝对不会被模糊化！对查像素非常重要 -->

                <Grid x:Name="ImageContainer" ClipToBounds="True" Background="#2D2D30"  PreviewMouseWheel="imgDisplay_MouseWheel">
                    <local:IndustrialImageViewer x:Name="PixelView"
                                 HorizontalAlignment="Stretch"
                                 VerticalAlignment="Stretch"
                                 MouseLeftButtonDown="ImageLeftButtonDown"
                                 MouseLeftButtonUp="ImageLeftButtonUp"
                                 MouseMove="ImageMouseMove"/>
                    <!-- ROI 区域，依然共享 Image 的变换矩阵 -->
                    <Canvas x:Name="ROI" Background="Transparent" Grid.Row="0" IsHitTestVisible="False" 
                                RenderTransform="{Binding ElementName=PixelView, Path=RenderTransform}" />
                </Grid>
                <Grid Grid.Row="1" Height="120" Width="auto" Visibility="{Binding IsImagesourceVisible,Converter={StaticResource BoolToVis},Mode=TwoWay}">
                    <Grid.RowDefinitions>
                        <RowDefinition Height="40"/>
                        <RowDefinition Height="*"/>
                    </Grid.RowDefinitions>
                    <StackPanel Grid.Row="0" Orientation="Horizontal"  Width="auto" HorizontalAlignment="Stretch" VerticalAlignment="Stretch">
                        <TextBlock Text="图像队列:" FontSize="16" Margin="0,10,0,0"/>
                        <TextBlock Text="0"  FontSize="16" Margin="10,10,0,0"/>
                        <Button Width="25" Height="25" Margin="40,0,0,0" Command="{Binding AddImageCommand}" Content="🖼️" Style="{StaticResource InheritButton}"/>
                        <Button Width="25" Height="25" Margin="40,0,0,0" Command="{Binding AddFileCommand}" Content="📁" Style="{StaticResource InheritButton}"/>
                        <Button Width="25" Height="25" Margin="40,0,0,0" Command="{Binding DeleteImageCommand}" Content="🗑️" Style="{StaticResource InheritButton}"/>
                    </StackPanel>
                    <ListBox
                        Grid.Row="1"
                        ItemsSource="{Binding ImageQueue}"
                        SelectedItem="{Binding SelectedImage ,Mode=TwoWay}"
                        ScrollViewer.HorizontalScrollBarVisibility="Auto"
                        ScrollViewer.VerticalScrollBarVisibility="Disabled"
                        Background="Transparent">
                        <ListBox.ItemsPanel>
                            <ItemsPanelTemplate>
                                <VirtualizingStackPanel Orientation="Horizontal" />
                            </ItemsPanelTemplate>
                        </ListBox.ItemsPanel>
                        <ListBox.ItemTemplate>
                            <DataTemplate>
                                <Grid Width="100" Height="80">
                                    <Image Source="{Binding Path}"/>
                                    <TextBlock Text="{Binding Name}" HorizontalAlignment="Center" Margin="0,5,0,0"/>
                                </Grid>
                            </DataTemplate>
                        </ListBox.ItemTemplate>
                    </ListBox>
                </Grid>
            </Grid>
        </Grid>
    </Grid>
</UserControl>
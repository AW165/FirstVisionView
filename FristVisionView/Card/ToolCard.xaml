<UserControl x:Class="FirstVisionView.Card.ToolCard"
             xmlns="http://schemas.microsoft.com/winfx/2006/xaml/presentation"
             xmlns:x="http://schemas.microsoft.com/winfx/2006/xaml"
             xmlns:mc="http://schemas.openxmlformats.org/markup-compatibility/2006" 
             xmlns:d="http://schemas.microsoft.com/expression/blend/2008" 
             xmlns:local="clr-namespace:FirstVisionView.Card"
             mc:Ignorable="d" 
             Height="80" Width="150">
    <Grid >
        <Border x:Name="ToolBorder" 
                Background="#FFFFFF"  
                CornerRadius="20" 
                BorderThickness="2" 
                IsHitTestVisible="True"
                BorderBrush="Transparent" 
                 >
            <Border.Style>
                <Style TargetType="Border" BasedOn="{StaticResource BorderStyle}">

                    <Style.Triggers>

                        <DataTrigger Binding="{Binding IsSelected}" Value="True">

                            <Setter Property="Effect">
                                <Setter.Value>
                                    <DropShadowEffect BlurRadius="10" Color="DodgerBlue" Opacity="0.8" ShadowDepth="0"/>
                                </Setter.Value>
                            </Setter>

                            <Setter Property="BorderBrush" Value="CornflowerBlue"/>
                            
                        </DataTrigger>
                    </Style.Triggers>
                </Style>
            </Border.Style>
            <Grid>
                <Grid.RowDefinitions>
                    <RowDefinition Height="auto"/>
                    <RowDefinition Height="*"/>
                    <RowDefinition Height="auto"/>

                </Grid.RowDefinitions>
                <Label Content="{Binding CardName}" FontSize="14"/>
                
            </Grid>
        </Border>

    </Grid>
</UserControl>

<UserControl x:Class="FirstVisionView.Card.ToolCard"
             xmlns="http://schemas.microsoft.com/winfx/2006/xaml/presentation"
             xmlns:x="http://schemas.microsoft.com/winfx/2006/xaml"
             xmlns:mc="http://schemas.openxmlformats.org/markup-compatibility/2006" 
             xmlns:d="http://schemas.microsoft.com/expression/blend/2008" 
             xmlns:local="clr-namespace:FirstVisionView.Card"
             xmlns:ui="http://schemas.lepo.co/wpfui/2022/xaml"
             mc:Ignorable="d" 
             xmlns:vm ="clr-namespace:FirstVisionView.ViewModels"
             
             d:Height="80" d:Width="150">
    <UserControl.Resources>
        <Style x:Key="pinStyle" TargetType="Ellipse">
            <Setter Property="Width" Value="12"/>
            <Setter Property="Height" Value="12"/>
            <Setter Property="Fill" Value="White"/>
            <Setter Property="Stroke" Value="DodgerBlue"/>
            <Setter Property="StrokeThickness" Value="1"/>
            <Setter Property="Cursor" Value="Cross"/>
            <Setter Property="Visibility" Value="Collapsed"/>
            <Style.Triggers>
                <DataTrigger Binding="{Binding IsMouseOver, RelativeSource={RelativeSource AncestorType={x:Type UserControl}}}" Value="True">
                    <Setter Property="Visibility" Value="Visible"/>
                </DataTrigger>
                <Trigger Property="IsMouseOver" Value="True">
                    <Setter Property="Fill" Value="Transparent"/>
                    <Setter Property="Width" Value="14"/>
                    <Setter Property="Height" Value="14"/>
                </Trigger>
            </Style.Triggers>
        </Style>
    </UserControl.Resources>

    <Grid >
        <Border x:Name="ToolBorder" 
                Height="80" 
                Width="150"
                Background="#FFFFFF"  
                CornerRadius="20" 
                BorderThickness="2" 
                IsHitTestVisible="True"
                BorderBrush="Transparent" 
                 >
            <Border.Style>
                <Style TargetType="Border" BasedOn="{StaticResource BorderStyle}">
                    <Style.Triggers>
                        <DataTrigger Binding="{Binding IsSelected}" Value="True">
                            <Setter Property="Effect">
                                <Setter.Value>
                                    <DropShadowEffect BlurRadius="10" Color="DodgerBlue" Opacity="0.8" ShadowDepth="0"/>
                                </Setter.Value>
                            </Setter>

                            <Setter Property="BorderBrush" Value="CornflowerBlue"/>

                        </DataTrigger>

                    </Style.Triggers>
                </Style>
            </Border.Style>
            <Grid>
                <Grid.RowDefinitions>
                    <RowDefinition Height="2*"/>
                    <RowDefinition Height="6*"/>
                    <RowDefinition Height="2*"/>
                </Grid.RowDefinitions>
                <TextBox x:Name="EditText" Text="{Binding CardName, Mode=TwoWay, UpdateSourceTrigger=PropertyChanged}"  BorderBrush="Transparent" Padding="0,3,0,0" FontSize="14" VerticalAlignment="Center" HorizontalAlignment="Center" LostFocus="EditText_LostFocus" KeyDown="EditText_KeyDown" IsVisibleChanged="EditText_IsVisibleChanged">
                    <TextBox.Style>
                        <Style TargetType="TextBox">
                            <Setter Property="Visibility" Value="Collapsed"/>
                            <Style.Triggers>
                                <DataTrigger Binding="{Binding IsRenaming}" Value="True">
                                    <Setter Property="Visibility" Value="Visible"/>
                                </DataTrigger>
                            </Style.Triggers>
                        </Style>
                    </TextBox.Style>
                </TextBox>
                <TextBlock x:Name="DisplayText" Text="{Binding CardName}"   Padding="0,3,0,0" FontSize="14" VerticalAlignment="Center" HorizontalAlignment="Center">
                    <TextBlock.Style>
                        <Style TargetType="TextBlock">
                            <Setter Property="Visibility" Value="Visible"/>
                            <Style.Triggers>
                                <DataTrigger Binding="{Binding IsRenaming}" Value="True">
                                    <Setter Property="Visibility" Value="Collapsed"/>
                                </DataTrigger>
                            </Style.Triggers>
                        </Style>
                    </TextBlock.Style>
                </TextBlock>
                <Grid Grid.Row="1">
                    <Grid.ColumnDefinitions>
                        <ColumnDefinition Width="1*"/>
                        <ColumnDefinition Width="1*"/>

                    </Grid.ColumnDefinitions>
                    <TextBlock HorizontalAlignment="Center" VerticalAlignment="Center">
                        <TextBlock.Style>
                            <Style TargetType="TextBlock">
                                <Setter Property="Text" Value="已启用"/>
                                <Style.Triggers>
                                    <DataTrigger Binding="{Binding IsEnable}" Value="True">
                                        <Setter Property="Text" Value="已启用"/>
                                    </DataTrigger>
                                    <DataTrigger Binding="{Binding IsEnable}" Value="False">
                                        <Setter Property="Text" Value="未启用"/>
                                    </DataTrigger>
                                </Style.Triggers>
                            </Style>
                        </TextBlock.Style>
                    </TextBlock>
                    <ui:ToggleSwitch Grid.Column="1" VerticalAlignment="Center" HorizontalAlignment="Center" Height="20" Width="40" IsChecked="{Binding IsEnable,Mode=TwoWay}"/>
                </Grid>
            </Grid>
        </Border>
        <Ellipse d:Visibility="Visible" x:Name="TopPin" HorizontalAlignment="Center" VerticalAlignment="Top" Style="{StaticResource pinStyle}" Margin="0,-4,0,0" MouseLeftButtonDown="PinLeftButtonDown" MouseLeftButtonUp="PinLeftButtonUp" />
        <Ellipse d:Visibility="Visible" x:Name="BottomPin" HorizontalAlignment="Center" VerticalAlignment="Bottom" Style="{StaticResource pinStyle}" Margin="0,0,0,-4" MouseLeftButtonDown="PinLeftButtonDown" MouseLeftButtonUp="PinLeftButtonUp" />
        <Ellipse d:Visibility="Visible" x:Name="LeftPin" HorizontalAlignment="Left" VerticalAlignment="Center" Style="{StaticResource pinStyle}" Margin="-4,0,0,0" MouseLeftButtonDown="PinLeftButtonDown" MouseLeftButtonUp="PinLeftButtonUp" />
        <Ellipse d:Visibility="Visible" x:Name="RightPin" HorizontalAlignment="Right" VerticalAlignment="Center" Style="{StaticResource pinStyle}" Margin="0,0,-4,0" MouseLeftButtonDown="PinLeftButtonDown" MouseLeftButtonUp="PinLeftButtonUp" />
    </Grid>

</UserControl>

<ResourceDictionary xmlns="http://schemas.microsoft.com/winfx/2006/xaml/presentation"
                    xmlns:x="http://schemas.microsoft.com/winfx/2006/xaml"
                    xmlns:global="clr-namespace:FirstVisionView"
                    xmlns:Core="clr-namespace:FirstVisionView.ParameterUILibary.Core">
    <DataTemplate DataType="{x:Type Core:SliderParameterItem}">
        <Grid Margin="10,5">
            <Grid.ColumnDefinitions>
                <ColumnDefinition Width="auto" SharedSizeGroup="ParamenterGroup"/>
                <ColumnDefinition Width="*"/>
                <ColumnDefinition Width="60"/>
            </Grid.ColumnDefinitions>

            <TextBlock Grid.Column="0" 
                       Text="{Binding Name}" 
                       VerticalAlignment="Center"
                       FontSize="20"
                       Foreground="Black" />
            <Slider Grid.Column="1" 
                    Height="25"
                    Width="250"
                    Minimum="{Binding Min}" 
                    Maximum="{Binding Max}" 
                    Value="{Binding Value}" 
                    TickFrequency="{Binding Step}"
                    IsSnapToTickEnabled="True"
                    VerticalAlignment="Center"
                    HorizontalAlignment="Left"
                    Margin="30,0,0,0"
                    Style="{StaticResource RoundSlider}"/>
            <TextBox Grid.Column="2" 
                     Text="{Binding Value, UpdateSourceTrigger=PropertyChanged}" 
                     VerticalAlignment="Center" 
                     BorderThickness="0"
                     FontSize="20"
                     TextAlignment="Center"/>
        </Grid>
    </DataTemplate>
    <DataTemplate DataType="{x:Type Core:ComboboxParameterItem}">
        <Grid Margin="10,5">
            <Grid.ColumnDefinitions>
                <ColumnDefinition Width="Auto" SharedSizeGroup="ParamenterGroup"/>
                <ColumnDefinition Width="*"/>
                <ColumnDefinition Width="60"/>
            </Grid.ColumnDefinitions>

            <TextBlock Grid.Column="0" 
               Text="{Binding Name}" 
               VerticalAlignment="Center"
               FontSize="20"
               Foreground="Black" />

            <ComboBox Grid.Column="1" 
                      global:ComboboxHelp.CornerRadius="10" 
                      Margin="30,0,0,0" Height="25" Width="150"  
                      Style="{StaticResource ComboboxStyle}" 
                      SelectedItem="{Binding SelectedValue,Mode=TwoWay}"
                      HorizontalAlignment="Left" VerticalAlignment="Center" 
                      ItemsSource="{Binding Options}"/>
        </Grid>
    </DataTemplate>
</ResourceDictionary>
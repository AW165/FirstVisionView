<ResourceDictionary xmlns="http://schemas.microsoft.com/winfx/2006/xaml/presentation"
                    xmlns:x="http://schemas.microsoft.com/winfx/2006/xaml"
                    xmlns:Core="clr-namespace:FirstVisionView.ParameterUILibary.Core">
    <DataTemplate DataType="{x:Type Core:SliderParameterItem}">
        <Grid Margin="10,5">
            <Grid.ColumnDefinitions>
                <ColumnDefinition Width="100"/>
                <ColumnDefinition Width="*"/>
                <ColumnDefinition Width="60"/>
            </Grid.ColumnDefinitions>

            <TextBlock Grid.Column="0" 
                       Text="{Binding Name}" 
                       VerticalAlignment="Center"
                       FontSize="20"
                       Foreground="Black" />
            <Slider Grid.Column="1" 
                    Minimum="{Binding Min}" 
                    Maximum="{Binding Max}" 
                    Value="{Binding Value}" 
                    TickFrequency="{Binding Step}"
                    IsSnapToTickEnabled="True"
                    VerticalAlignment="Center" 
                    Margin="5,0"/>

            <TextBox Grid.Column="2" 
                     Text="{Binding Value, UpdateSourceTrigger=PropertyChanged}" 
                     VerticalAlignment="Center" 
                     FontSize="20"
                     TextAlignment="Center"/>
        </Grid>
    </DataTemplate>
    <DataTemplate DataType="{x:Type Core:BaseParameterItem}">
        <Grid>
            <Label FontSize="30" HorizontalAlignment="Center" VerticalAlignment="Center" Content="{Binding Title}"/>
        </Grid>
    </DataTemplate>
</ResourceDictionary>